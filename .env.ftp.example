# Copy to .env.ftp, fill locally, then chmod 600 .env.ftp.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Folder relatif terhadap direktori login FTP; awali / untuk path absolut.
FTP_REMOTE_DIR=public_html/other/kemplang
# Default FTPS (TLS wajib). false hanya jika server mendukung FTP tanpa enkripsi.
FTP_SECURE=true
